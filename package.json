{
  "name": "tweakpage",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test",
    "icons": "node scripts/icon.mjs",
    "audit:selectors": "esbuild scripts/audit-entry.ts --bundle --format=iife --outfile=/tmp/twk-audit.js --log-level=error && node scripts/selector-audit.mjs",
    "shots": "wxt build && node scripts/shots.mjs",
    "package": "wxt build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@medv/finder": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.11.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ],
    "overrides": {
      "shell-quote": ">=1.8.3",
      "tmp": ">=0.2.4",
      "adm-zip": ">=0.5.16",
      "uuid": ">=11"
    }
  }
}
