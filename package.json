{
  "name": "tweakpage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "e2e": "wxt build && playwright test",
    "shots": "wxt build && node scripts/shots.mjs",
    "package": "wxt build && node scripts/zip.mjs"
  },
  "dependencies": {
    "@medv/finder": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@testing-library/react": "^16.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@wxt-dev/module-react": "^1.1.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10",
    "wxt": "^0.20.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "spawn-sync"
    ]
  }
}
